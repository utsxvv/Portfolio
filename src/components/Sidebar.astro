---
const { selectedItem } = Astro.props;
---

<aside
  data-animation="default"
  data-collapse="medium"
  data-duration="400"
  data-easing="ease"
  data-easing2="ease"
  role="banner"
  class="sidebar w-nav"
>
  <div class="nav-content">
    <div class="header-wrapper">
      <a href="/" class="w-nav-brand" aria-label="home">
        <div class="niv-data">
          <img
            src="/assets/image/logo.jpg"
            loading="eager"
            alt="Profile picture"
            class="niv-image"
          />
          <div class="brand-text">
            <div class="label-white">Utsav Patel</div>
            <div class="label-gray">Software Developer</div>
          </div>
        </div>
      </a>

      <div
        class="navbar-icon-button w-nav-button"
        aria-label="menu"
        role="button"
        tabindex="0"
      >
        <img src="/assets/svg/menu.svg" loading="eager" alt="" class="navbar-icon" />
      </div>
    </div>

    <nav role="navigation" class="w-nav-menu">
      <a href="/" class={`nav-link-container w-inline-block ${selectedItem === 'home' ? 'w--current' : ''}`}>
        <img src="/assets/svg/home.svg" loading="eager" alt="" class="nav-link-image" />
        <div>Home</div>
      </a>
      <a href="/software-development" class={`nav-link-container w-inline-block ${selectedItem === 'software-development' ? 'w--current' : ''}`}>
        <img src="/assets/svg/code.svg" loading="eager" alt="" class="nav-link-image" />
        <div>Software development</div>
      </a>
      <a href="/aiml" class={`nav-link-container w-inline-block ${selectedItem === 'aiml' ? 'w--current' : ''}`}>
        <img src="/assets/svg/ai.svg" loading="eager" alt="" class="nav-link-image" />
        <div>AI/ML</div>
      </a>
      <a href="/journey" class={`nav-link-container w-inline-block ${selectedItem === 'journey' ? 'w--current' : ''}`}>
        <img src="/assets/svg/timeline.svg" loading="eager" alt="" class="nav-link-image" />
        <div>Journey</div>
      </a>
      <a href="/uses" class={`nav-link-container w-inline-block ${selectedItem === 'uses' ? 'w--current' : ''}`}>
        <img src="/assets/svg/backpack.svg" loading="eager" alt="" class="nav-link-image" />
        <div>Uses</div>
      </a>
      <a href="/bookmarks" class={`nav-link-container w-inline-block ${selectedItem === 'bookmarks' ? 'w--current' : ''}`}>
        <img src="/assets/svg/bookmark.svg" loading="eager" alt="" class="nav-link-image" />
        <div>Bookmarks</div>
      </a>
    </nav>

    <div class="sidebar-status-container">
      <div class="sidebar-status-item">
        <span class="status-label">Ahmedabad, IN</span>
        <span id="sidebar-time" class="status-value">00:00:00</span>
      </div>
    </div>
  </div>

  <script>
    import { setupNav } from '../scripts/nav.js';
    
    function updateSidebarTime() {
      const timeElement = document.getElementById('sidebar-time');
      if (!timeElement) return;
      const options = {
        timeZone: 'Asia/Kolkata',
        hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true
      };
      timeElement.textContent = new Intl.DateTimeFormat('en-IN', options).format(new Date());
    }

    let cleanup;
    document.addEventListener('astro:page-load', () => {
      if (cleanup) cleanup();
      cleanup = setupNav();
      updateSidebarTime();
      const timer = setInterval(updateSidebarTime, 1000);
      window._sidebarTimer = timer;
    });

    document.addEventListener('astro:before-swap', () => {
      if (cleanup) cleanup();
      if (window._sidebarTimer) clearInterval(window._sidebarTimer);
    });
  </script>
</aside>

<style>
  .nav-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    padding-bottom: 24px;
  }

  .header-wrapper {
    display: contents;
  }

  .sidebar-status-container {
    margin-top: auto;
    padding: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .sidebar-status-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .status-label {
    font-size: 0.65rem;
    color: #444;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
  }

  .status-value {
    font-size: 0.9rem;
    color: #999;
    font-family: 'JetBrains Mono', monospace;
  }

  @media (max-width: 991px) {
    .header-wrapper {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
    }

    .sidebar-status-container {
      display: none;
    }

    .w-nav-menu {
      top: 80px !important;
      background: #1c1c1c;
    }
  }
</style>