---
const { date, title, company, desc, type } = Astro.props;
---

<div class="timeline-item">
  <div class="timeline-dot"></div>
  <div class="timeline-content">
    <span class="timeline-date">{date}</span>
    <h3>{title}</h3>
    <div class="timeline-company">{company}</div>
    <p>{desc}</p>
    
    <div class="chips-container">
       <div class="single-chip small-chip">{type}</div>
    </div>
  </div>
</div>

<style>
  .timeline-item {
    position: relative;
    padding-left: 40px;
    margin-bottom: 40px;
  }

  .timeline-dot {
    position: absolute;
    left: 0;
    top: 5px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #ffffff;
    border: 4px solid #1a1a1a; 
    z-index: 1;
  }

  .timeline-date {
    font-size: 0.9rem;
    color: #888;
    font-weight: bold;
  }

  .timeline-content h3 {
    margin: 5px 0;
    color: #fff;
    font-size: 1.25rem;
  }

  .timeline-company {
    color: #fff; 
    font-weight: 500;
    margin-bottom: 12px;
  }

  .chips-container {
    margin-top: 10px;
    display: flex;
    gap: 8px;
  }
</style>