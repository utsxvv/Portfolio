---
const { name, icon, desc, href } = Astro.props;
---

<a href={href} target="_blank" class="uses-item-link">
  <div class="uses-item">
    <div class="uses-header">
      <img src={icon} alt={name} class="uses-icon" />
      <div class="uses-title-area">
        <h3>{name}</h3>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="external-icon"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
    </div>
    <p class="uses-desc">{desc}</p>
  </div>
</a>

<style>
  .uses-item-link {
    text-decoration: none;
    display: block;
    transition: transform 0.2s ease;
  }
  
  .uses-item-link:hover {
    transform: translateY(-2px);
  }

  .uses-item {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid #333;
    padding: 20px;
    border-radius: 12px;
    height: 100%; /* Ensures all cards match height */
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .uses-item:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: #444;
  }

  .uses-header {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 12px;
    position: relative;
  }

  .uses-icon {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }

  .uses-title-area h3 {
    margin: 0;
    font-size: 1.1rem;
    color: #fff;
    font-weight: 500;
  }

  .external-icon {
    margin-left: auto;
    color: #555;
    transition: color 0.3s ease;
  }

  .uses-item:hover .external-icon {
    color: #fff;
  }

  .uses-desc {
    color: #888;
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
  }
</style>