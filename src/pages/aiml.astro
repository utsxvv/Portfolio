---
import Layout from "../layouts/Layout.astro";
import Project from "../components/Project.astro";

const projects = [
    {
    title: "BookChat - PDF RAG Assistant",
    summary: "Built an AI-powered PDF question-answering application using Retrieval-Augmented Generation (RAG), allowing users to upload books and interact with their content through a conversational interface.",
    desc: [
      "Developed a Streamlit-based application that allows users to upload PDF books, extract and split text into chunks, and store document embeddings in ChromaDB.",
      "Implemented semantic search using Hugging Face embeddings and Maximum Marginal Relevance (MMR) retrieval to find relevant passages, with Groq-powered LLM responses and source page references."
    ],
    tech: ["Python", "LangChain", "RAG", "Hugging Face", "ChromaDB", "Groq", "Streamlit"],
    link: "https://github.com/utsxvv/RAG_Book_Assistant"
  },
    {
    title: "PharmaLens - Handwritten Prescription OCR",
    summary: "Built a handwritten medicine name recognition system using a custom CRNN model and an automated preprocessing pipeline.",
    desc: [
      "Built a handwritten medicine name recognition system using a custom CRNN model trained from scratch",
      "Developed a data collection pipeline using Label Studio with automated cropping, CLAHE preprocessing, and augmentation to expand the training dataset.",
    ],
    tech: ["Python", "PyTorch", "CRNN", "BiLSTM", "Kaggle"],
    link: "https://github.com/utsxvv/PharmaLens"
  },
];
---

<Layout title="AI/ML | Utsav Patel" selectedItem="aiml">
  <div class="back-nav-container">
    <a href="/" class="back-nav-button w-inline-block">
      <img src="/assets/svg/back.svg" loading="lazy" alt="" class="back-nav-img" />
      <div>Back</div>
    </a>
  </div>

  <div class="content-container">
    <h1>AI/ML</h1>
    <p class="section-description">
      Exploration of machine learning models and their integration into modern web architectures, focusing on scalable and intelligent digital solutions.
    </p>

    <section class="items-container">
      <div class="resouce-items">
        {projects.length > 0 ? (
          projects.map(project => (
            <Project 
              title={project.title} 
              summary={project.summary}
              desc={project.desc}
              tech={project.tech}
              link={project.link}
            />
          ))
        ) : (
          <p class="coming-soon">Projects coming soon...</p>
        )}
      </div>
    </section>
  </div>
</Layout>

<style>
  .section-description {
    margin-top: 10px;
    margin-bottom: 30px;
    font-size: 1.1rem;
    color: #cccccc;
    line-height: 1.6;
  }
  .coming-soon {
    font-style: italic;
    opacity: 0.6;
    margin-top: 20px;
    color: #888;
  }
  
  .content-container {
    max-width: 800px;
  }
</style>