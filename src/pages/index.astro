---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Utsav Patel" selectedItem="home">
  <main class="fold-content-container">
    <div class="fold-content">
      <h1>Hi, I'm Utsav.<br />A software developer with a focus on AI/ML.</h1>
      <p class="lead">
        I work across frontend and backend development, building full-stack web applications while pursuing a master’s in AI and machine learning, with a focus on writing clean code and solving real-world problems.
      </p>
    </div>
    <a 
      href="https://mail.google.com/mail/?view=cm&fs=1&to=utssavvpatel@gmail.com&su=Inquiry%20from%20Portfolio&body=Hi%20Utsav," 
      target="_blank" 
      class="button w-button"
    >
      Contact
    </a>
  </main>

  <div class="projects-section">
    <a href="/software-development" class="projects-container">
      <div class="single-projects-category">
        <div class="projects-category-image-container">
          <img src="/assets/svg/browser.svg" loading="lazy" alt="Software Development" class="projects-category-image" />
        </div>
      </div>
      <div class="single-projects-content">
        <h4>Software Development</h4>
        <div class="tech-tools-container">
          <div class="mini-label-white gray-color">Technologies &amp; tools</div>
          <div class="chips-container chips-container-small-width">
            <div class="single-chip small-chip">React</div>
            <div class="single-chip small-chip">Node.js</div>
            <div class="single-chip small-chip">Django</div>
            <div class="single-chip small-chip">JavaScript</div>
            <div class="single-chip small-chip">Python</div>
            <div class="single-chip small-chip">CodeIgniter</div>
            <div class="single-chip small-chip">HTML5</div>
            <div class="single-chip small-chip">CSS3</div>
          </div>
        </div>
      </div>
    </a>

    <a href="/aiml" class="projects-container">
      <div class="single-projects-category">
        <div class="projects-category-image-container devops-img">
          <img src="/assets/svg/ai-ml.svg" loading="lazy" alt="AI and ML" class="projects-category-image" />
        </div>
      </div>
      <div class="single-projects-content">
        <h4>AI &amp; Machine Learning</h4>
        <div class="tech-tools-container">
          <div class="mini-label-white gray-color">Technologies &amp; tools</div>
          <div class="chips-container chips-container-small-width">
            <div class="single-chip small-chip">Python</div>
            <div class="single-chip small-chip">Exploring...</div>
          </div>
        </div>
      </div>
    </a>
  </div>
</Layout>